// Cloudflare Worker "licina": serves dist/site/ (from `bun run site`) as static assets.
// Custom domains stay as configured in the dashboard.
{
  "name": "licina",
  "compatibility_date": "2026-11-26",
  // only the custom domain: no duplicate of the site on *.workers.dev, no preview URLs
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "dist/site",
    "html_handling": "auto-trailing-slash"
  }
}
